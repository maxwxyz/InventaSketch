<?xml version="1.0" encoding="UTF-8"?>
<!-- Sidebar deck "InventaSketch" with the panel "Library" in Impress, Draw and Calc. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
    oor:name="Sidebar" oor:package="org.openoffice.Office.UI">
  <node oor:name="Content">
    <node oor:name="DeckList">
      <node oor:name="InventaSketchDeck" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en-US">InventaSketch</value>
          <value xml:lang="de">InventaSketch</value>
        </prop>
        <prop oor:name="Id" oor:type="xs:string"><value>InventaSketchDeck</value></prop>
        <prop oor:name="IconURL" oor:type="xs:string"><value>vnd.sun.star.extension://org.inventasketch.libreoffice/icons/inventasketch-26.png</value></prop>
        <prop oor:name="ContextList"><value oor:separator=";">Impress, any, visible ;Draw, any, visible ;Calc, any, visible ;</value></prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>900</value></prop>
      </node>
    </node>
    <node oor:name="PanelList">
      <node oor:name="InventaSketchLibraryPanel" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en-US">Library</value>
          <value xml:lang="de">Bibliothek</value>
        </prop>
        <prop oor:name="Id" oor:type="xs:string"><value>InventaSketchLibraryPanel</value></prop>
        <prop oor:name="DeckId" oor:type="xs:string"><value>InventaSketchDeck</value></prop>
        <prop oor:name="ContextList"><value oor:separator=";">Impress, any, visible ;Draw, any, visible ;Calc, any, visible ;</value></prop>
        <prop oor:name="ImplementationURL" oor:type="xs:string"><value>private:resource/toolpanel/InventaSketchPanelFactory/Library</value></prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>100</value></prop>
        <prop oor:name="WantsCanvas" oor:type="xs:boolean"><value>false</value></prop>
      </node>
    </node>
  </node>
</oor:component-data>
