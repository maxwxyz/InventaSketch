<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu "InventaSketch" in Impress, Draw and Calc (commands: inventasketch_component.py). -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
    oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <node oor:name="OfficeMenuBar">
      <node oor:name="org.inventasketch.libreoffice.menu" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en-US">InventaSketch</value>
          <value xml:lang="de">InventaSketch</value>
        </prop>
        <prop oor:name="Context" oor:type="xs:string">
          <value>com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.sheet.SpreadsheetDocument</value>
        </prop>
        <node oor:name="Submenu">
          <node oor:name="m01" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>inventasketch.libreoffice:library</value></prop>
            <prop oor:name="Title" oor:type="xs:string">
              <value xml:lang="en-US">Insert from Library...</value>
              <value xml:lang="de">Aus Bibliothek einfügen ...</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
          <node oor:name="m02" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>inventasketch.libreoffice:editModel</value></prop>
            <prop oor:name="Title" oor:type="xs:string">
              <value xml:lang="en-US">Edit Model of Selected Unit</value>
              <value xml:lang="de">Modell der ausgewählten Einheit bearbeiten</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
          <node oor:name="m03" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>inventasketch.libreoffice:redraw</value></prop>
            <prop oor:name="Title" oor:type="xs:string">
              <value xml:lang="en-US">Redraw Selected Unit from Model</value>
              <value xml:lang="de">Ausgewählte Einheit aus dem Modell neu zeichnen</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
          <node oor:name="m04" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>inventasketch.libreoffice:numeral</value></prop>
            <prop oor:name="Title" oor:type="xs:string">
              <value xml:lang="en-US">Add Reference Numeral</value>
              <value xml:lang="de">Bezugszeichen hinzufügen</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
          <node oor:name="m05" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
          </node>
          <node oor:name="m06" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>inventasketch.libreoffice:cleanup</value></prop>
            <prop oor:name="Title" oor:type="xs:string">
              <value xml:lang="en-US">Remove Data of Deleted Units</value>
              <value xml:lang="de">Daten gelöschter Einheiten entfernen</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
          <node oor:name="m07" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>inventasketch.libreoffice:about</value></prop>
            <prop oor:name="Title" oor:type="xs:string">
              <value xml:lang="en-US">About InventaSketch</value>
              <value xml:lang="de">Über InventaSketch</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
