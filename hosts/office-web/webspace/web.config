<?xml version="1.0" encoding="utf-8"?>
<!-- InventaSketch web add-in on your own web server (IIS). Lies in the uploaded folder. Office add-ins cannot sign in to the
     server, so access cannot be restricted to the add-in: use a folder with a name that cannot be guessed, keep it out of
     search engines and reject crawlers and tools (IIS request filtering, no extra modules).
     Precompressed files (*.br, *.gz) would need the optional URL Rewrite module, whose absence turns a <rewrite> section into
     an error for the whole folder; therefore IIS compresses the files itself (urlCompression) and serves the originals.
     Ported from Slidemax (same copyright holder, Apache-2.0 transfer approved 2026-11-20). -->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- Without application/wasm the engine does not load; IIS does not serve unknown types (.dll, .dat, .blat) at all. -->
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".dll" />
      <mimeMap fileExtension=".dll" mimeType="application/octet-stream" />
      <remove fileExtension=".dat" />
      <mimeMap fileExtension=".dat" mimeType="application/octet-stream" />
      <remove fileExtension=".blat" />
      <mimeMap fileExtension=".blat" mimeType="application/octet-stream" />
      <remove fileExtension=".pdb" />
      <mimeMap fileExtension=".pdb" mimeType="application/octet-stream" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="text/javascript" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".br" />
      <mimeMap fileExtension=".br" mimeType="application/octet-stream" />
      <remove fileExtension=".gz" />
      <mimeMap fileExtension=".gz" mimeType="application/octet-stream" />
      <!-- Updates: revalidate every file before use, so a new version arrives right after the upload. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.00:00:00" cacheControlCustom="no-cache" />
    </staticContent>
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />
    <directoryBrowse enabled="false" />
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <!-- Office shows the add-in in an embedded frame: do not send a frame block. -->
        <remove name="X-Frame-Options" />
        <add name="X-Robots-Tag" value="noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <!-- Crawlers, preview services, AI collectors and tools; not "Teams", "Office" or browser names. -->
        <filteringRules>
          <filteringRule name="InventaSketch-Crawler" scanUrl="false" scanQueryString="false">
            <scanHeaders>
              <add requestHeader="User-Agent" />
            </scanHeaders>
            <denyStrings>
              <add string="bot" />
              <add string="crawl" />
              <add string="spider" />
              <add string="slurp" />
              <add string="archiver" />
              <add string="scrapy" />
              <add string="facebookexternalhit" />
              <add string="embedly" />
              <add string="skypeuripreview" />
              <add string="microsoftpreview" />
              <add string="bingpreview" />
              <add string="whatsapp" />
              <add string="semrush" />
              <add string="ahrefs" />
              <add string="bytespider" />
              <add string="chatgpt" />
              <add string="anthropic" />
              <add string="perplexity" />
              <add string="headless" />
              <add string="selenium" />
              <add string="puppeteer" />
              <add string="playwright" />
              <add string="curl" />
              <add string="wget" />
              <add string="python" />
              <add string="go-http" />
              <add string="okhttp" />
              <add string="libwww" />
              <add string="httpclient" />
              <add string="postman" />
              <add string="nmap" />
              <add string="nikto" />
              <add string="sqlmap" />
              <add string="zgrab" />
            </denyStrings>
          </filteringRule>
        </filteringRules>
        <hiddenSegments>
          <add segment=".htaccess" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
